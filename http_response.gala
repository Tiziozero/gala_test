// http.gala

import "core/core.gala";
import "core/mem.gala";

fn http_reason(status: i64): string {
    if status == 200 { return "OK"; }
    if status == 201 { return "Created"; }
    if status == 204 { return "No Content"; }
    if status == 301 { return "Moved Permanently"; }
    if status == 302 { return "Found"; }
    if status == 304 { return "Not Modified"; }
    if status == 400 { return "Bad Request"; }
    if status == 401 { return "Unauthorized"; }
    if status == 403 { return "Forbidden"; }
    if status == 404 { return "Not Found"; }
    if status == 405 { return "Method Not Allowed"; }
    if status == 408 { return "Request Timeout"; }
    if status == 413 { return "Payload Too Large"; }
    if status == 500 { return "Internal Server Error"; }
    if status == 501 { return "Not Implemented" ; }
    if status == 503 { return "Service Unavailable"; }
    return "Unknown";
}

// number of decimal digits of v (v >= 0)
fn http_digits(v: i64): i64 {
    x := v;
    n := 1;
    while x >= 10 {
        x = x / 10;
        n += 1;
    }
    return n;
}

// The http_put_* helpers write at `pos` and return the new position.
fn http_put_str(buf: []byte, pos: i64, s: string): i64 {
    n := len(s);
    if n == 0 { return pos; }
    mem_copy(transmute(rawptr)&buf[pos], transmute(rawptr)&s[0], cast(u64)n);
    return pos + n;
}

fn http_put_bytes(buf: []byte, pos: i64, src: []byte): i64 {
    n := len(src);
    if n == 0 { return pos; }
    mem_copy(transmute(rawptr)&buf[pos], transmute(rawptr)&src[0], cast(u64)n);
    return pos + n;
}

fn http_put_int(buf: []byte, pos: i64, v: i64): i64 {
    n := http_digits(v);
    x := v;
    i := n - 1;
    while i >= 0 {
        buf[pos + i] = cast(byte)(48 + x % 10);
        x = x / 10;
        i -= 1;
    }
    return pos + n;
}

fn http_put_crlf(buf: []byte, pos: i64): i64 {
    buf[pos] = 13;
    buf[pos + 1] = 10;
    return pos + 2;
}

// Builds a whole HTTP/1.1 response (status line, headers, blank line, body)
// in one allocation. Returns an empty slice if the allocation fails.
// Free with free_bytes(resp, a).
//   resp := make_http_response(("Hello")[:]);
//   resp := make_http_response(body, 404, a = arena_allocator(&arena));
fn make_http_response(body: []byte, status := 200, content_type := "text/plain; charset=utf-8", a: Allocator = base_allocator): []byte {
    reason := http_reason(status);

    total := len("HTTP/1.1 ") + http_digits(status) + 1 + len(reason) + 2;
    total += len("Content-Type: ") + len(content_type) + 2;
    total += len("Content-Length: ") + http_digits(len(body)) + 2;
    total += len("Connection: close") + 2;
    total += 2 + len(body);

    out := alloc_bytes(total, a);
    if len(out) == 0 { return out; }

    pos := 0;
    pos = http_put_str(out, pos, "HTTP/1.1 ");
    pos = http_put_int(out, pos, status);
    pos = http_put_str(out, pos, " ");
    pos = http_put_str(out, pos, reason);
    pos = http_put_crlf(out, pos);

    pos = http_put_str(out, pos, "Content-Type: ");
    pos = http_put_str(out, pos, content_type);
    pos = http_put_crlf(out, pos);

    pos = http_put_str(out, pos, "Content-Length: ");
    pos = http_put_int(out, pos, len(body));
    pos = http_put_crlf(out, pos);

    pos = http_put_str(out, pos, "Connection: close");
    pos = http_put_crlf(out, pos);
    pos = http_put_crlf(out, pos);

    pos = http_put_bytes(out, pos, body);
    return out;
}
