// main.gala

import "core/core.gala";
import "core/net.gala";
import "core/mem.gala";
import "core/cfunctions.gala";
import "core/map.gala";
import "core/io.gala";
import "core/json.gala";
import "./http_response.gala";


struct VoidSlice {
    p: rawptr,
    size: u64,
}

fn slice_from_ptr(p: rawptr, size: u64): []void {
    return transmute([]void)(VoidSlice{p, size});
}


fn stringcmp(a: string, b: string): bool {
    if len(a) != len(b) { return false; }
    i := 0;
    while i < len(a) {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    return true;
}


struct HttpRequest {
    headers: ^Map(string, string),
    path: string,
    kind: string,
    body: []byte,
    a: Allocator,
}

struct ParsedHeader {
    k, v: string,
}


// Returns everything before the first separator and advances the string.
// If no separator exists, returns the entire string and leaves it empty.
fn http_take_until(s: ^string, sep: byte): string {
    i := 0;

    while i < len(s^) {
        if s^[i] == sep {
            result := transmute(string)(s^[:i]);
            s^ = transmute(string)(s^[i + 1:]);
            return result;
        }

        i += 1;
    }

    result := transmute(string)(s^[:i]);
    s^ = transmute(string)(s^[i:]);

    return result;
}


// Returns the next CRLF-terminated line and advances past it.
// Returns an empty string when no complete line is available.
fn http_request_next_line(s: ^string): string {
    i := 0;

    while i + 1 < len(s^) {
        if s^[i] == 13 && s^[i + 1] == 10 {
            result := transmute(string)(s^[:i]);
            s^ = transmute(string)(s^[i + 2:]);
            return result;
        }

        i += 1;
    }

    return "";
}


struct HttpServer {
    port: u16,
    handlers: Map(string, RequestHandler),
}

fn http_parse_request(data: []byte, r: ^HttpRequest, a: Allocator): bool {
    request := transmute(string)data;
    whole_request := request;

    // Parse the request line.
    request_line := http_request_next_line(&request);

    if len(request_line) == 0 {
        println("Invalid request line:", whole_request);
        return false;
    }

    request_parts := request_line;

    request_type := http_take_until(&request_parts, 32);
    path := http_take_until(&request_parts, 32);
    version := http_take_until(&request_parts, 32);

    if len(request_type) == 0 || len(path) == 0 || len(version) == 0 {
        println("Malformed request line:", whole_request);
        return false;
    }


    headers := cast(^Map(string,string))alloc(size_of(Map(string, string)), a=a);
    headers^ = map_make( 128, "", "", hash_str, eq_str, a);


    // Parse headers until the empty line separating headers and body.
    while true {
        header_line := http_request_next_line(&request);

        if len(header_line) == 0 {
            break;
        }

        parsed := http_parse_header(header_line);

        if len(parsed.k) == 0 {
            println("Malformed header:", header_line);
            return false;
        }

        map_put(headers, parsed.k, parsed.v);
    }
    body := request[:]; // rest of request
    r^ = HttpRequest{ headers=headers, path=path, kind=request_type, body=body, a=a, };
    return true;
}
fn http_serve(s: ^HttpServer): i32 {
    listener := tcp_listen(1234, 10);
    if listener.fd < 0 {
        println("Failed to listen on port 1234.");
        return -1;
    }

    data := [1024*8]byte{};

    println("Listening on port 1234.");
    while true {
        client := tcp_accept(listener);

        n := tcp_recv(client, data[:]);
        if n <= 0 {
            println("Failed to receive request from client.");
            tcp_shutdown(client, SHUT_RDWR);
            tcp_close(client);
            continue;
        }

        // Allocate memory for this request.
        arena := arena_make(1024 * 1024 * 16);
        allocator := arena_allocator(&arena);
        request := HttpRequest{ headers = 0, path = "", kind = "", body = ("")[:], a = allocator, };
        if !http_parse_request(data[:], &request, allocator) {
            println("Failed to parse http request.");
            arena_destroy(&arena);

            tcp_shutdown(client, SHUT_RDWR);
            tcp_close(client);
            continue;
        }


        f: RequestHandler = fn(r: HttpRequest):[]byte { return ("")[:]; };
        if !map_get(&s^.handlers, request.path, &f) {
            println("No handler registered for path:", request.path);

            response := make_http_response(
                ("Not Found")[:],
                status = 404,
                a = arena_allocator(&arena),
                content_type = "text/plain; charset=utf-8",
            );
            tcp_send(client, response);
            
        } else {
            r := f(request);
            tcp_send(client, r);
        }

        arena_destroy(&arena);

        tcp_shutdown(client, SHUT_RDWR);
        tcp_close(client);
    }

    tcp_close(listener);
    return 0;
}
// Parses a header in the form "Name: Value".
fn http_parse_header(s: string): ParsedHeader {
    i := 0;

    while i < len(s) {
        if s[i] == (":")[0] {
            key := transmute(string)(s[:i]);

            value_start := i + 1;
            if value_start < len(s) && s[value_start] == 32 {
                value_start += 1;
            }

            value := transmute(string)(s[value_start:]);

            return ParsedHeader{key, value};
        }

        i += 1;
    }

    return ParsedHeader{"", ""};
}

alias RequestHandler = fn(r: HttpRequest): []byte;

fn main(): i32 {
    f_home := fn(r: HttpRequest): []byte {
        value := "";

        if !map_get(r.headers, "User-Agent", &value) {
            println("Failed to get User-Agent header.");
        }

        if map_get(r.headers, "Content-Type", &value) {
            if stringcmp(value, "application/json") {
                println("JSON:", transmute(string)(r.body));

                json := JsonValue{0, "", 0, 0};

                if !json_parse(transmute(string)(r.body), &json, r.a) {
                    println("Failed to parse JSON.");

                    return make_http_response(
                        ("Invalid JSON")[:],
                        status = 400,
                        a = r.a,
                        content_type = "text/plain; charset=utf-8",
                    );
                }

                if !map_get_m(json.obj^, "value", &json) {
                    println("Failed to get 'value' from JSON.");

                    return make_http_response(
                        ("Missing value")[:],
                        status = 400,
                        a = r.a,
                        content_type = "text/plain; charset=utf-8",
                    );
                }

                println("Value:", json.num);
            }
        }

        return make_http_response(
            ("<!DOCTYPE html><html><head></head><body><h1>Hello, World!</h1><img src=\"/i\" /></body></html>")[:],
            status = 200,
            a = r.a,
            content_type = "text/html; charset=utf-8",
        );
    };

    f_i := fn(r: HttpRequest): []byte {
        image := open_file("./apple.png", r.a);

        if len(image) == 0 {
            println("Failed to open image: ./apple.png");

            return make_http_response(
                ("Failed to open image")[:],
                status = 500,
                a = r.a,
                content_type = "text/plain; charset=utf-8",
            );
        }

        return make_http_response(
            image,
            status = 200,
            a = r.a,
            content_type = "image/png",
        );
    };
    handlers := map_make(10, "", f_i, hash_str, eq_str, );
    map_put(&handlers, "/", f_home);
    map_put(&handlers, "/i", f_i);
    s := HttpServer{port=1234, handlers=handlers};
    return http_serve(&s);
}
