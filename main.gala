// main.gala

import "core/core.gala";
import "core/net.gala";
import "core/tls.gala";
import "core/mem.gala";
import "core/cfunctions.gala";
import "core/map.gala";
import "core/io.gala";
import "core/json.gala";
import "./http_response.gala";

running: bool = true;
struct VoidSlice {
    p: rawptr,
    size: u64,
}

fn slice_from_ptr(p: rawptr, size: u64): []void {
    return transmute([]void)(VoidSlice{p, size});
}


fn stringcmp(a: string, b: string): bool {
    if len(a) != len(b) { return false; }
    i := 0;
    while i < len(a) {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    return true;
}


struct HttpRequest {
    headers: ^Map(string, string),
    path: string,
    kind: string,
    body: []byte,
    a: Allocator,
}

struct ParsedHeader {
    k, v: string,
}


// Returns everything before the first separator and advances the string.
// If no separator exists, returns the entire string and leaves it empty.
fn http_take_until(s: ^string, sep: byte): string {
    i := 0;

    while i < len(s^) {
        if s^[i] == sep {
            result := transmute(string)(s^[:i]);
            s^ = transmute(string)(s^[i + 1:]);
            return result;
        }

        i += 1;
    }

    result := transmute(string)(s^[:i]);
    s^ = transmute(string)(s^[i:]);

    return result;
}


// Returns the next CRLF-terminated line and advances past it.
// Returns an empty string when no complete line is available.
fn http_request_next_line(s: ^string): string {
    i := 0;

    while i + 1 < len(s^) {
        if s^[i] == 13 && s^[i + 1] == 10 {
            result := transmute(string)(s^[:i]);
            s^ = transmute(string)(s^[i + 2:]);
            return result;
        }

        i += 1;
    }

    return "";
}


struct HttpServer {
    port: u16,
    handlers: Map(string, RequestHandler),
}

fn http_parse_request(data: []byte, r: ^HttpRequest, a: Allocator): bool {
    request := transmute(string)data;
    whole_request := request;

    // Parse the request line.
    request_line := http_request_next_line(&request);

    if len(request_line) == 0 {
        println("Invalid request line:", whole_request);
        return false;
    }

    request_parts := request_line;

    request_type := http_take_until(&request_parts, 32);
    path := http_take_until(&request_parts, 32);
    version := http_take_until(&request_parts, 32);

    if len(request_type) == 0 || len(path) == 0 || len(version) == 0 {
        println("Malformed request line:", whole_request);
        return false;
    }


    headers := cast(^Map(string,string))alloc(size_of(Map(string, string)), a=a);
    headers^ = map_make::<string,string>(128, hash_str, eq_str, a);


    // Parse headers until the empty line separating headers and body.
    while true {
        header_line := http_request_next_line(&request);

        if len(header_line) == 0 {
            break;
        }

        parsed := http_parse_header(header_line);

        if len(parsed.k) == 0 {
            println("Malformed header:", header_line);
            return false;
        }

        map_put(headers, parsed.k, parsed.v);
    }
    body := request[:]; // rest of request
    r^ = HttpRequest{ headers=headers, path=path, kind=request_type, body=body, a=a, };
    return true;
}
// Parses a header in the form "Name: Value".
fn http_parse_header(s: string): ParsedHeader {
    i := 0;

    while i < len(s) {
        if s[i] == (":")[0] {
            key := transmute(string)(s[:i]);

            value_start := i + 1;
            if value_start < len(s) && s[value_start] == 32 {
                value_start += 1;
            }

            value := transmute(string)(s[value_start:]);

            return ParsedHeader{key, value};
        }

        i += 1;
    }

    return ParsedHeader{"", ""};
}

// Register a route.
fn http_register_handler(
    handlers: ^Map(string, RequestHandler),
    path: string,
    handler: RequestHandler,
) {
    map_put(handlers, path, handler);
}


// Parse the request body as JSON.
// Returns false if parsing fails.
fn http_parse_json_body(r: HttpRequest, out: ^JsonValue): bool {
    return json_parse(transmute(string)(r.body), out, r.a);
}


// Return a text response.
fn http_provide_text(
    body: string,
    status: i64 = 200,
    a: Allocator = base_allocator,
): []byte {
    return make_http_response(
        transmute([]byte)(body),
        status = status,
        a = a,
        content_type = "text/plain; charset=utf-8",
    );
}


// Return an HTML response.
fn http_provide_html(
    body: string,
    status: i64 = 200,
    a: Allocator = base_allocator,
): []byte {
    return make_http_response(
        transmute([]byte)(body),
        status = status,
        a = a,
        content_type = "text/html; charset=utf-8",
    );
}


// Read a file and return it as a response.
// An empty file is treated as a read failure, matching the existing code.
fn http_provide_file(
    path: string,
    content_type: string,
    a: Allocator,
): []byte {
    file := open_file(path, a);

    if len(file) == 0 {
        println("Failed to open file:", path);

        return http_provide_text(
            "Failed to open file",
            status = 500,
            a = a,
        );
    }

    return make_http_response(
        file,
        status = 200,
        a = a,
        content_type = content_type,
    );
}


// Convenience wrapper for images.
fn http_provide_image(path: string, content_type: string, a: Allocator): []byte {
    return http_provide_file(path, content_type, a);
}


alias RequestHandler = fn(r: HttpRequest): []byte;


fn http_serve(s: ^HttpServer): i32 {
    // A client hanging up mid-write must not kill the server.
    signal(SIGPIPE, SIG_IGN);

    listener := tcp_listen(s^.port, 10);
    if listener.fd < 0 {
        println("Failed to listen on port", s^.port);
        return -1;
    }

    // Shared TLS context: certificate + private key, created once.
    tls_ctx := tls_make_context("tls/cert.pem", "tls/key.pem");
    if tls_ctx == 0 {
        println("Failed to set up TLS (check cert.pem / key.pem).");
        tcp_close(listener);
        return -1;
    }

    data := [1024*8]byte{};

    println("Listening (https) on port", s^.port);
    while running {
        client := tcp_accept(listener);

        // TLS handshake on the accepted socket.
        conn := tls_accept(tls_ctx, client);
        if conn.ssl == 0 {
            println("TLS handshake failed.");
            tcp_shutdown(client, SHUT_RDWR);
            tcp_close(client);
            continue;
        }

        n := tls_recv(conn, data[:]);
        if n <= 0 {
            println("Failed to receive request from client.");
            tls_close(conn);
            tcp_shutdown(client, SHUT_RDWR);
            tcp_close(client);
            continue;
        }

        // Allocate memory for this request.
        arena := arena_make(1024 * 1024 * 16);
        allocator := arena_allocator(&arena);
        request := HttpRequest{ headers = 0, path = "", kind = "", body = ("")[:], a = allocator, };

        // Only parse the n bytes actually received, not the whole 8 KB buffer.
        if !http_parse_request(data[:n], &request, allocator) {
            println("Failed to parse http request.");
            arena_destroy(&arena);

            tls_close(conn);
            tcp_shutdown(client, SHUT_RDWR);
            tcp_close(client);
            continue;
        }


        f: RequestHandler = fn(r: HttpRequest):[]byte { return ("")[:]; };
        if !map_get(&s^.handlers, request.path, &f) {
            println("No handler registered for path:", request.path);

            response := make_http_response(
                ("Not Found")[:],
                status = 404,
                a = arena_allocator(&arena),
                content_type = "text/plain; charset=utf-8",
            );
            tls_send(conn, response);

        } else {
            r := f(request);
            tls_send(conn, r);
        }

        arena_destroy(&arena);

        tls_close(conn);
        tcp_shutdown(client, SHUT_RDWR);
        tcp_close(client);
    }

    println("Shutting down.");
    SSL_CTX_free(tls_ctx);
    tcp_close(listener);
    return 0;
}


fn main(): i32 {
    f_home := fn(r: HttpRequest): []byte {
        value := "";

        if !map_get(r.headers, "User-Agent", &value) {
            println("Failed to get User-Agent header.");
        }

        if map_get(r.headers, "Content-Type", &value) {
            if stringcmp(value, "application/json") {
                json := JsonValue{0, "", 0, 0};

                if !http_parse_json_body(r, &json) {
                    return http_provide_text(
                        "Invalid JSON",
                        status = 400,
                        a = r.a,
                    );
                }

                if !map_get_m(json.obj^, "value", &json) {
                    return http_provide_text(
                        "Missing value",
                        status = 400,
                        a = r.a,
                    );
                }

                println("Value:", json.num);
            }
        }

        return http_provide_html(
            "<!DOCTYPE html><html><head></head><body><h1>Hello, World!</h1><img src=\"/i\" /></body></html>",
            a = r.a,
        );
    };

    f_i := fn(r: HttpRequest): []byte {
        return http_provide_image(
            "./apple.png",
            "image/png",
            r.a,
        );
    };

    // Debug only: remove before exposing the server publicly.
    f_quit := fn(r: HttpRequest): []byte {
        running = false;
        return http_provide_text("Shutting down", a = r.a);
    };

    handlers := map_make::<string, RequestHandler>(
        10,
        hash_str,
        eq_str,
    );

    http_register_handler(&handlers, "/", f_home);
    http_register_handler(&handlers, "/i", f_i);
    http_register_handler(&handlers, "/quit", f_quit);

    s := HttpServer{port = 25565, handlers = handlers};
    c := http_serve(&s);
    map_free(&handlers);
    return c;
}
